{
  "hooks": {
    "SessionStart": [
      {
        "id": "inject-skills",
        "description": "Inject the minimal arcforge bootstrap context + ARCFORGE_ROOT (bash, writes CLAUDE_ENV_FILE).",
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" inject-skills/main.sh"
          }
        ]
      },
      {
        "id": "inject-context",
        "description": "Inject resume context (session summary, activated instincts).",
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-tracker/inject-context.js\""
          }
        ]
      },
      {
        "id": "session-start",
        "description": "Create the session file and lazily start the observer daemon (async).",
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-tracker/start.js\"",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "id": "user-message-counter",
        "description": "Increment the diary user-message counter (stdin-passthrough; stays standalone).",
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/user-message-counter/main.js\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "id": "guard-dispatcher",
        "description": "Sync BLOCK guard dispatcher: arc-guard + sdd-ledger-guard + sdd-ratify-guard.",
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-pre.js\""
          }
        ]
      },
      {
        "id": "observe-pre",
        "description": "Append the pre-tool observation (async — daemon I/O stays off the blocking path).",
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/observe/main.js\" pre",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "id": "post-dispatcher",
        "description": "Sync PostToolUse dispatcher: quality-check accumulator + arc-remind + compact-suggester.",
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-post.js\""
          }
        ]
      },
      {
        "id": "observe-post",
        "description": "Append the post-tool observation (async).",
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/observe/main.js\" post",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "id": "session-end",
        "description": "Finalize the session, run the diary-capture threshold, and batch the quality checks.",
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-tracker/end.js\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "id": "pre-compact",
        "description": "Reset the suggester state and run diary-capture before compaction.",
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-compact/main.js\""
          }
        ]
      }
    ]
  }
}
