{
  "hooks": {
    "SessionStart": [
      {
        "id": "inject-context",
        "description": "Inject resume context (session summary, activated instincts).",
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-tracker/inject-context.js\""
          }
        ]
      },
      {
        "id": "session-start",
        "description": "Create the session file and lazily start the observer daemon (async).",
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-tracker/start.js\"",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "id": "user-message-counter",
        "description": "Increment the diary user-message counter (stdin-passthrough).",
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/user-message-counter/main.js\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "id": "secrets-guard",
        "description": "Warn-only scan for hardcoded credentials in Edit/Write content and git commit commands.",
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/secrets-guard/main.js\""
          }
        ]
      },
      {
        "id": "observe-pre",
        "description": "Append the pre-tool observation (async — daemon I/O stays off the blocking path).",
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/observe/main.js\" pre",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "id": "compact-suggester",
        "description": "Increment the shared diary tool-count on every event and suggest /compact at the threshold.",
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/compact-suggester/main.js\""
          }
        ]
      },
      {
        "id": "observe-post",
        "description": "Append the post-tool observation (async).",
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/observe/main.js\" post",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "id": "session-end",
        "description": "Finalize the session and run the threshold-gated diary capture.",
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-tracker/end.js\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "id": "pre-compact",
        "description": "Reset the suggester state and run diary-capture before compaction.",
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-compact/main.js\""
          }
        ]
      }
    ]
  }
}
